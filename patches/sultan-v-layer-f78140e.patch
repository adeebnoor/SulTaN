diff --git a/tests/open-lists.test.js b/tests/open-lists.test.js
new file mode 100644
index 0000000..2c15445
--- /dev/null
+++ b/tests/open-lists.test.js
@@ -0,0 +1,42 @@
+/* Open suggestion lists (datalist) must never become closed selects, and the
+   bundled Vision 2030 reference list must stay data — not locale strings. */
+'use strict';
+const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path'),vm=require('node:vm');
+const root=path.resolve(__dirname,'..');
+const read=f=>fs.readFileSync(path.join(root,f),'utf8');
+const app=read('src/app.js'),index=read('index.html');
+
+/* 1. the helper must branch on Array before the closed-select branch */
+assert.ok(/if\(Array\.isArray\(options\)\)/.test(app),'field() must render an open datalist for array options');
+assert.ok(app.indexOf('Array.isArray(options)')<app.indexOf('else if(options)input=`<select'),'array branch must precede the select branch');
+assert.ok(/<input [^`]*list="\$\{esc\(lid\)\}"/.test(app),'datalist input must carry a list attribute');
+assert.ok(/<datalist id="\$\{esc\(lid\)\}">/.test(app),'a datalist element must be emitted');
+
+/* 2. judgement fields must stay free text — a closed list here kills the product */
+for(const guarded of ['whyUs','tradeoff','decisionReason','outcome','foothold','adaptation','notDoing'])
+  assert.ok(!new RegExp("\\['"+guarded+"',T\\('s\\d+'\\),'text','',").test(app),'judgement field must not gain a list: '+guarded);
+
+/* 3. the five wired fields */
+for(const wired of [/\['sector',T\('s\d+'\),'text','',SECTORS\(\)\]/,/\['unit',T\('s\d+'\),'text','',UNITS\(\)\]/,/\['frequency',T\('s\d+'\),'text','',FREQS\(\)\]/,/\['title',T\('s\d+'\),'text','',\(globalThis\.SultanVision/])
+  assert.ok(wired.test(app),'expected an open list wiring: '+wired);
+
+/* 4. the bundled reference list */
+assert.ok(index.includes('src/locales/vision.js'),'browser must load the bundled programme list');
+const ctx={globalThis:{SultanLocales:{en:{},ar:{}}}};vm.createContext(ctx);
+vm.runInContext(read('src/locales/vision.js'),ctx,{filename:'vision.js'});
+const V=ctx.globalThis.SultanVision;
+assert.equal(V.programs.length,11,'Vision 2030 has 11 realization programs');
+assert.ok(/^\d{4}-\d{2}-\d{2}$/.test(V.verifiedOn),'the list must carry the date it was verified');
+for(const x of V.programs){for(const k of ['id','code','ar','en'])assert.equal(typeof x[k],'string','programme field '+k);assert.ok(x.ar.trim()&&x.en.trim());}
+assert.equal(new Set(V.programs.map(x=>x.id)).size,11,'programme ids must be unique');
+assert.equal(V.titles('ar').length,11);assert.equal(V.titles('en').length,11);
+assert.notDeepEqual(V.titles('ar'),V.titles('en'),'both locales must be translated');
+/* the programme list must NOT leak into SultanLocales: i18n.test.js requires every value be a string */
+for(const [k,v] of Object.entries(ctx.globalThis.SultanLocales.ar))assert.equal(typeof v,'string','locale value must be a string: '+k);
+assert.equal(ctx.globalThis.SultanLocales.ar.programs,undefined,'programme data must live on SultanVision, not SultanLocales');
+/* the no-endorsement wording is a legal requirement, not decoration */
+assert.ok(/غير مرتبط/.test(ctx.globalThis.SultanLocales.ar.visionListDisclaimer),'Arabic disclaimer must disclaim affiliation');
+assert.ok(/not affiliated/i.test(ctx.globalThis.SultanLocales.en.visionListDisclaimer),'English disclaimer must disclaim affiliation');
+assert.ok(/%\{1\}/.test(ctx.globalThis.SultanLocales.ar.visionListDisclaimer),'the disclaimer must interpolate the verification date');
+
+console.log(JSON.stringify({suite:'open-lists',passed:true,programs:V.programs.length,verifiedOn:V.verifiedOn}));
